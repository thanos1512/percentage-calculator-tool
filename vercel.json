{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/mainindex.html", "destination": "/", "permanent": true },
    { "source": "/bmi-calculator", "destination": "/", "permanent": true },
    { "source": "/percentage-calculator.html", "destination": "/percentage-calculator/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
